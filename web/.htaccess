# Flutter web SPA — لنطاق فرعي (agency.point-iq.app) الجذر = /. لمسار فرعي (/agency/) استخدم RewriteBase ذلك المسار.
# تقليل احتمال عرض index.html قديم من كاش المتصفح/السيرفر بعد النشر
<IfModule mod_headers.c>
  <Files "index.html">
    Header set Cache-Control "max-age=0, no-cache, must-revalidate"
  </Files>
  <FilesMatch "^(flutter_service_worker|flutter_bootstrap|main\.dart)\.js$">
    Header set Cache-Control "max-age=0, no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.html [L]
</IfModule>
