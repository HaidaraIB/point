# Copy to .env and fill in values. Never commit .env or service account JSON.

# --- Firebase (Firestore scan + rewrite) ---
# Option A: path to service account JSON (upload firebase-sa.json with the zip)
GOOGLE_APPLICATION_CREDENTIALS=./firebase-sa.json

# Option B: inline JSON (single line, escape quotes if needed)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# --- Cloudflare R2 (copy target) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=point
R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev

# --- Supabase (source downloads + optional purge) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=point
# SUPABASE_STORAGE_BASE_URL=
