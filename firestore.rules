rules_version = '2';
// قواعد Firestore: تتطلب Firebase Auth + مستند authRoles/{uid} للموظفين/العملاء.
// يزامن التطبيق authRoles عبر FirestoreServices.syncAuthRoleForEmployee / syncAuthRoleForClient.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function authRoleDoc() {
      return get(/databases/$(database)/documents/authRoles/$(request.auth.uid));
    }

    function authRoleData() {
      return authRoleDoc().data;
    }

    function hasAuthRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/authRoles/$(request.auth.uid));
    }

    function isAdmin() {
      return hasAuthRole() && authRoleData().role == 'admin';
    }

    function isSupervisor() {
      return hasAuthRole() && authRoleData().role == 'supervisor';
    }

    function isManager() {
      return isAdmin() || isSupervisor();
    }

    function isEmployeeRole() {
      return hasAuthRole() && authRoleData().role == 'employee';
    }

    function isClientRole() {
      return hasAuthRole() && authRoleData().role == 'client';
    }

    function myEmployeeId() {
      return authRoleData().employeeId;
    }

    function myClientId() {
      return authRoleData().clientId;
    }

    function appVersionGateValidMinBuild(value) {
      return value is number && value >= 0;
    }

    function attendanceValidCoordinate(value) {
      return value is number && value >= -180 && value <= 180;
    }

    function attendanceValidRadius(value) {
      return value is number && value > 0 && value <= 5000;
    }

    function validAttendanceSettings(data) {
      return data.keys().hasAll(['latitude', 'longitude', 'radiusMeters'])
        && attendanceValidCoordinate(data.latitude)
        && attendanceValidCoordinate(data.longitude)
        && attendanceValidRadius(data.radiusMeters)
        && (!('label' in data) || data.label is string)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function validAttendanceRecord(data) {
      return data.keys().hasAll([
          'employeeId',
          'employeeName',
          'action',
          'latitude',
          'longitude',
          'distanceMeters',
          'officeLatitude',
          'officeLongitude',
          'officeRadiusMeters',
          'photoUrl',
          'recordedAt',
        ])
        && data.employeeId is string
        && data.employeeName is string
        && (data.action == 'present' || data.action == 'left')
        && data.photoUrl is string
        && data.photoUrl.size() > 0
        && attendanceValidCoordinate(data.latitude)
        && attendanceValidCoordinate(data.longitude)
        && data.distanceMeters is number
        && data.distanceMeters >= 0
        && attendanceValidCoordinate(data.officeLatitude)
        && attendanceValidCoordinate(data.officeLongitude)
        && attendanceValidRadius(data.officeRadiusMeters)
        && data.distanceMeters <= data.officeRadiusMeters
        && data.recordedAt is timestamp;
    }

    function sliceDepartments(m) {
      let dd = m.get('departments', []);
      return dd is list ? dd : [];
    }

    function myDepartmentsList() {
      let prim = sliceDepartments(authRoleData());
      return prim.size() > 0
        ? prim
        : (
            authRoleData().keys().hasAny(['department'])
            && authRoleData().department is string
            && authRoleData().department != ''
            ? [authRoleData().department]
            : []
          );
    }

    function employeeDepartments(emp) {
      let prim = sliceDepartments(emp);
      return prim.size() > 0
        ? prim
        : (
            emp.keys().hasAny(['department'])
            && emp.department is string
            && emp.department != ''
            ? [emp.department]
            : []
          );
    }

    // مستند employees: تطابق صاحب الحساب (authUid أو بريد JWT عند غياب authUid في البيانات القديمة).
    function employeeDocOwnedByCaller() {
      return resource.data.authUid == request.auth.uid
        || (
          (resource.data.authUid == null || resource.data.authUid == '')
          && request.auth.token.email != null
          && resource.data.email == request.auth.token.email
        );
    }

    function actorParticipantId() {
      return isClientRole() ? myClientId() : myEmployeeId();
    }

    function authRoleDeptMatchesEmployee(emp, deptsFromRequest) {
      let r = emp.role;
      let ed = employeeDepartments(emp);
      let dr = deptsFromRequest is list ? deptsFromRequest : [];
      return (r == 'admin' || r == 'supervisor')
        ? (dr.size() == 0 || (ed.hasAll(dr) && dr.hasAll(ed)))
        : (ed.hasAll(dr) && dr.hasAll(ed) && ed.size() == dr.size());
    }

    function requestedAuthRoleDepartments(d) {
      let prim = sliceDepartments(d);
      return prim.size() > 0
        ? prim
        : (
            d.keys().hasAny(['department'])
            && d.department is string
            && d.department != ''
            ? [d.department]
            : []
          );
    }

    // authRoles sync runs on login; employees.authUid may still be empty (chicken-and-egg vs hasAuthRole()).
    function employeeAuthUidMatchesForAuthRolesSync(emp) {
      return emp.authUid == request.auth.uid
        || (
          employeeAuthUidLooksUnset(emp)
          && request.auth.token.email != null
          && emp.email == request.auth.token.email
        );
    }

    function validateEmployeeAuthRolePayload() {
      let d = request.resource.data;
      let empPath = /databases/$(database)/documents/employees/$(d.employeeId);
      return exists(empPath)
        && employeeAuthUidMatchesForAuthRolesSync(get(empPath).data)
        && get(empPath).data.role == d.role
        && authRoleDeptMatchesEmployee(
          get(empPath).data,
          requestedAuthRoleDepartments(d),
        );
    }

    function clientAuthUidLooksUnset(cl) {
      return !(cl.keys().hasAny(['authUid']))
        || cl.authUid == null
        || cl.authUid == '';
    }

    function clientAuthUidMatchesForAuthRolesSync(cl) {
      return cl.authUid == request.auth.uid
        || (
          clientAuthUidLooksUnset(cl)
          && request.auth.token.email != null
          && cl.email == request.auth.token.email
        );
    }

    function validateClientAuthRolePayload() {
      let d = request.resource.data;
      let clPath = /databases/$(database)/documents/clients/$(d.clientId);
      return exists(clPath)
        && d.role == 'client'
        && d.employeeId == null
        && clientAuthUidMatchesForAuthRolesSync(get(clPath).data);
    }

    function authRoleDocKeysAllowed() {
      return request.resource.data.keys().hasOnly([
        'role',
        'employeeId',
        'clientId',
        'departments',
        'department',
        'updatedAt',
      ]);
    }

    function authRolesDepartmentsMigrationByAdmin(uid) {
      return exists(/databases/$(database)/documents/authRoles/$(uid))
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['departments', 'department', 'updatedAt'])
        && request.resource.data.role == resource.data.role
        && request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.clientId == resource.data.clientId;
    }

    function validateAuthRoleWrite() {
      let d = request.resource.data;
      return authRoleDocKeysAllowed()
        && ((d.role == 'client' && validateClientAuthRolePayload())
            || (d.role != 'client' && validateEmployeeAuthRolePayload()));
    }

    function taskMatchesAnyEmployeeDepartment(taskType, depts) {
      return (taskType == '0' && depts.hasAny(['promotion']))
        || (taskType == '1' && depts.hasAny(['design']))
        || (taskType == '2' && depts.hasAny(['photography']))
        || (taskType == '3' && depts.hasAny(['content-writing']))
        || (taskType == '4' && depts.hasAny(['montage']))
        || (taskType == '5' && depts.hasAny(['publishing']))
        || (taskType == '6' && depts.hasAny(['programming']))
        || (taskType == '7' && depts.hasAny(['administration']));
    }

    function canReadTaskDoc() {
      return isManager()
        || (isEmployeeRole() && (
          taskMatchesAnyEmployeeDepartment(resource.data.type, myDepartmentsList())
          || resource.data.assignedTo == myEmployeeId()
        ));
    }

    // موظف: لا يضع حالة موافقة/رفض بنفسه؛ ولا يعيد المهمة من «موافق» إلى قيد التنفيذ/مراجعة
    // (التسليم النهائي فقط → status_task_completed أو status_published).
    function employeeTaskEmployeeStatusUpdateForbidden() {
      let ns = request.resource.data.status;
      let os = resource.data.status;
      return isEmployeeRole()
        && (
          ((ns == 'status_approved' || ns == 'status_rejected') && ns != os)
          || (os == 'status_approved' && ns != os
              && ns != 'status_task_completed'
              && ns != 'status_published')
        );
    }

    function employeeTaskUpdateAllowed() {
      return request.resource.data.assignedTo == resource.data.assignedTo
        && !employeeTaskEmployeeStatusUpdateForbidden();
    }

    function canReadContentsDoc() {
      return isManager()
        || (isEmployeeRole() && myDepartmentsList().hasAny(['promotion', 'publishing']))
        || (isClientRole() && resource.data.clientId == myClientId());
    }

    // authRoles قد يتأخر عن employees (role / departments) — نفس منطق الواجهة تقريباً.
    function metaPublishCallerEmployeeExists() {
      return hasAuthRole()
        && !isClientRole()
        && authRoleData().keys().hasAny(['employeeId'])
        && authRoleData().employeeId is string
        && authRoleData().employeeId != ''
        && exists(/databases/$(database)/documents/employees/$(authRoleData().employeeId));
    }

    function metaPublishEmployeeRoleIsManager(r) {
      return r in ['admin', 'Admin', 'supervisor', 'Supervisor'];
    }

    function metaPublishEmployeeDocShowsManager() {
      return metaPublishCallerEmployeeExists()
        && metaPublishEmployeeRoleIsManager(
          get(/databases/$(database)/documents/employees/$(authRoleData().employeeId)).data.role
        );
    }

    function metaPublishCanReadAppSettingsOrMetaPosts() {
      return isManager()
        || metaPublishEmployeeDocShowsManager();
    }

    function metaPublishCanWriteAppSettingsMeta() {
      return isManager() || metaPublishEmployeeDocShowsManager();
    }

    // موظف ترويج: يعدّل حقل promotion فقط.
    function promotionEmployeeContentUpdateAllowed() {
      return isEmployeeRole() && myDepartmentsList().hasAny(['promotion'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['promotion']);
    }

    // موظف نشر: يعدّل دون لمس promotion (لا حذف — allow delete منفصل).
    function publishingEmployeeContentUpdateAllowed() {
      return isEmployeeRole() && myDepartmentsList().hasAny(['publishing'])
        && request.resource.data.clientId == resource.data.clientId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['promotion']);
    }

    // قراءة clients: موظفون/مديرون؛ عميل لمستنده؛ أو مستخدم مسجّل بريده يطابق المستند (تسجيل دخول قبل authRoles)
    // أو غير مسجّل (استعلام loginClient/loginEmployee قبل signIn).
    function canReadClientsDoc() {
      return !isSignedIn()
        || isManager()
        || (isClientRole() && resource.id == myClientId())
        || isEmployeeRole()
        || (isSignedIn()
          && request.auth.token.email != null
          && resource.data.email == request.auth.token.email);
    }

    function canReadEmployeesDoc() {
      return !isSignedIn() || isSignedIn();
    }

    function isMyDepartmentGroupChat(chatIdParam) {
      return isEmployeeRole()
        && (
          (myDepartmentsList().hasAny(['promotion']) && chatIdParam == 'group_promotion')
          || (myDepartmentsList().hasAny(['design']) && chatIdParam == 'group_design')
          || (myDepartmentsList().hasAny(['photography']) && chatIdParam == 'group_photography')
          || (myDepartmentsList().hasAny(['content-writing']) && chatIdParam == 'group_content-writing')
          || (myDepartmentsList().hasAny(['montage']) && chatIdParam == 'group_montage')
          || (myDepartmentsList().hasAny(['publishing']) && chatIdParam == 'group_publishing')
          || (myDepartmentsList().hasAny(['programming']) && chatIdParam == 'group_programming')
          || (myDepartmentsList().hasAny(['administration']) && chatIdParam == 'group_administration')
        );
    }

    // محادثات مجموعة الأقسام: معرّفات group_<slug> (انظر StorageKeys.departmentSlugs).
    // للقراءة/الاستعلام: لا نعتمد على مطابقة نصية لـ authRoles.department مع slug المستند
    // (قد يكون الحقل عربيًا أو بأحرف مختلفة) — يكفي أن يكون المستخدم ضمن participants.
    function isDepartmentGroupChatId(chatIdParam) {
      return chatIdParam.matches('group_.+');
    }


    function chatGet(chatIdParam) {
      return get(/databases/$(database)/documents/chats/$(chatIdParam));
    }

    function employeeCanReadGroupChatMessages(chatIdParam) {
      let c = chatGet(chatIdParam);
      return c.data.isGroup == true
        && (actorParticipantId() in c.data.participants || isMyDepartmentGroupChat(chatIdParam));
    }

    function expectedPrivateChatId(otherId) {
      let myId = myEmployeeId();
      return myId < otherId ? (myId + '_' + otherId) : (otherId + '_' + myId);
    }

    function chatDataForId(chatIdParam) {
      return get(/databases/$(database)/documents/chats/$(chatIdParam)).data;
    }

    function messageParticipantInChat(chatIdParam) {
      return actorParticipantId() in chatDataForId(chatIdParam).participants;
    }

    // Typing subdocs: same access pattern as /chats/{id}/messages (read + create parity).
    function privateTypingReaderAllowed(chatIdParam) {
      return isSignedIn() && hasAuthRole()
        && (
          isManager()
          || (
            isEmployeeRole()
            && (
              employeeCanReadGroupChatMessages(chatIdParam)
              || (
                chatGet(chatIdParam).data.isGroup != true
                && actorParticipantId() in chatGet(chatIdParam).data.participants
              )
            )
          )
          || (
            isClientRole()
            && actorParticipantId() in chatGet(chatIdParam).data.participants
          )
        );
    }

    function privateTypingActorMayWrite(chatIdParam, typingUserId) {
      return isSignedIn() && hasAuthRole()
        && typingUserId == actorParticipantId()
        && (
          isManager()
          || (
            isEmployeeRole()
            && (
              employeeCanReadGroupChatMessages(chatIdParam)
              || (
                chatGet(chatIdParam).data.isGroup != true
                && actorParticipantId() in chatGet(chatIdParam).data.participants
                && employeeOtherAllowedInPrivateChat(chatGet(chatIdParam).data.participants)
              )
            )
          )
          || (
            isClientRole()
            && actorParticipantId() in chatGet(chatIdParam).data.participants
          )
        );
    }

    function privateTypingCreateDataOk() {
      return request.resource.data.keys().hasOnly(['updatedAtMs'])
        && request.resource.data.updatedAtMs is int;
    }

    function privateTypingUpdateDataOk() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAtMs'])
        && request.resource.data.updatedAtMs is int;
    }

    /// يضمّ منطق قراءة رسائل المجموعة: مشارك، أو موظف بقسم يطابق المجموعة قبل الانضمام الرسمي.
    function messageActorMayMarkRead(chatIdParam) {
      return isManager()
        || messageParticipantInChat(chatIdParam)
        || (isEmployeeRole() && employeeCanReadGroupChatMessages(chatIdParam));
    }

    function messageDocIsTextEditable(m) {
      return !m.keys().hasAny(['messageType'])
        || m.messageType == 'text'
        || m.messageType == '';
    }

    function messageDocNotSoftDeleted(m) {
      return !m.keys().hasAny(['deleted']) || m.deleted != true;
    }

    function messageMarkReadUpdate(chatIdParam) {
      let d = request.resource.data.diff(resource.data).affectedKeys();
      return d.hasOnly(['isRead'])
        && resource.data.senderId != actorParticipantId()
        && messageActorMayMarkRead(chatIdParam)
        && request.resource.data.isRead == true
        && (!resource.data.keys().hasAny(['isRead']) || resource.data.isRead != true);
    }

    function messageSoftDeleteByAdmin(chatIdParam) {
      let d = request.resource.data.diff(resource.data).affectedKeys();
      return isAdmin()
        && messageParticipantInChat(chatIdParam)
        && d.hasOnly(['deleted', 'deletedAt', 'deletedBy'])
        && request.resource.data.deleted == true
        && request.resource.data.deletedBy == actorParticipantId();
    }

    function messageTextEditBody(chatIdParam) {
      let d = request.resource.data.diff(resource.data).affectedKeys();
      return d.hasOnly(['text', 'edited', 'editedAt'])
        && messageParticipantInChat(chatIdParam)
        && messageDocIsTextEditable(resource.data)
        && messageDocNotSoftDeleted(resource.data);
    }

    function messageTextEditBySender(chatIdParam) {
      return resource.data.senderId == actorParticipantId()
        && !isAdmin()
        && messageTextEditBody(chatIdParam);
    }

    function messageTextEditByAdmin(chatIdParam) {
      return isAdmin()
        && messageTextEditBody(chatIdParam);
    }

    function messagePinUpdate(chatIdParam) {
      let d = request.resource.data.diff(resource.data).affectedKeys();
      let pinFieldsOk = d.hasOnly(['isPinned', 'pinnedAt', 'pinnedBy']);
      let pinAction =
        request.resource.data.isPinned == true
        && request.resource.data.pinnedBy == actorParticipantId()
        && request.resource.data.pinnedAt is timestamp;
      let unpinAction =
        request.resource.data.isPinned == false
        && !request.resource.data.keys().hasAny(['pinnedAt', 'pinnedBy']);
      return messageParticipantInChat(chatIdParam)
        && messageDocNotSoftDeleted(resource.data)
        && pinFieldsOk
        && (pinAction || unpinAction);
    }

    function messageDocAt(chatIdParam, messageIdParam) {
      return get(/databases/$(database)/documents/chats/$(chatIdParam)/messages/$(messageIdParam)).data;
    }

    // للإنشاء/التحديث: التحقق من الطرف الآخر عبر employees.
    // يجب exists قبل get — وإلا تفشل القاعدة إن لم يوجد المستند.
    function employeeOtherAllowedInPrivateChat(participants) {
      let myId = myEmployeeId();
      let otherId = participants[0] == myId ? participants[1] : participants[0];
      let otherPath = /databases/$(database)/documents/employees/$(otherId);
      return participants.size() == 2
        && participants.hasAny([myId])
        && exists(otherPath)
        && (
          get(otherPath).data.role == 'admin'
          || get(otherPath).data.role == 'supervisor'
          || employeeDepartments(get(otherPath).data).hasAny(myDepartmentsList())
        );
    }

    // للقراءة + استعلامات chats (arrayContains): بدون get(employees) —
    // لا تُشترط participants.size()==2 هنا: الاستعلام يضمن arrayContains فقط،
    // فإن اشترطنا الحجم ترفض Firestore الاستعلام كاملاً (أي مستند مطابق محتمل يفشل القاعدة).
    // حجم 2 وسياسة الطرف الآخر تبقى على create/update للرسائل.

    // ربط أول تسجيل دخول: authUid/authStatus (قبل وجود authRoles).
    // يُسمح بتغيير authUid/authStatus فقط، مع إما عدم وجود authUid أو مطابقة البريد مع JWT.
    function employeeAuthUidLooksUnset(emp) {
      return !(emp.keys().hasAny(['authUid']))
        || emp.authUid == null
        || emp.authUid == '';
    }

    function employeeAuthBootstrapUpdate() {
      let affected =
        request.resource.data.diff(resource.data).affectedKeys();
      let onlyAuthFields =
        affected.hasOnly(['authUid', 'authStatus'])
        || affected.hasOnly(['authUid'])
        || affected.hasOnly(['authStatus']);
      let emailMatchesJwt =
        request.auth.token.email != null
        && resource.data.email == request.auth.token.email;
      return isSignedIn()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.authStatus == 'active'
        && onlyAuthFields
        && (employeeAuthUidLooksUnset(resource.data) || emailMatchesJwt);
    }

    // ensureTestAdminUser (kDebug + ENABLE_TEST_ADMIN): إنشاء employees/admin-test قبل أي جلسة.
    // يقتصر على قيم ثابتة ومفاتيح مطابقة لـ EmployeeModel.toJson دون authUid.
    function testAdminDevEmployeeBootstrapCreate(employeeId) {
      let d = request.resource.data;
      return !isSignedIn()
        && employeeId == 'admin-test'
        && d.id == 'admin-test'
        && d.email == 'point@admin.app'
        && d.role == 'admin'
        && d.status == 'active'
        && d.name == 'Point Test (Admin)'
        && d.authStatus == 'active'
        && (!d.keys().hasAny(['authUid']) || d.authUid == null)
        && d.keys().hasOnly([
          'id',
          'name',
          'email',
          'phone',
          'role',
          'departments',
          'fcmToken',
          'onesignal',
          'hireDate',
          'status',
          'createdAt',
          'authStatus',
          'image',
        ]);
    }

    match /authRoles/{uid} {
      // Own doc: always (incl. before first sync completes). Managers: list/query all for dashboards + migration.
      allow read: if isSignedIn()
        && (
          request.auth.uid == uid
          || (hasAuthRole() && isManager())
        );
      allow create: if isSignedIn() && request.auth.uid == uid && validateAuthRoleWrite();
      allow update: if (isSignedIn() && request.auth.uid == uid && validateAuthRoleWrite())
        || (isSignedIn() && hasAuthRole() && isManager() && authRolesDepartmentsMigrationByAdmin(uid));
      allow delete: if false;
    }

    match /meta/{docId} {
      allow read: if isSignedIn() && hasAuthRole() && isManager();
      // Supervisors run the same client backfill path as admins.
      allow create, update: if isSignedIn() && hasAuthRole() && isManager()
        && docId == 'employee_departments_v1';
      allow delete: if false;
    }

    match /employees/{employeeId} {
      allow read: if canReadEmployeesDoc();

      allow create: if isSignedIn() && hasAuthRole() && isManager()
        || testAdminDevEmployeeBootstrapCreate(employeeId);

      // لا يحذف المسؤول مستند موظفه الخاص (يُمنع قفل الحساب بالخطأ).
      allow delete: if isSignedIn() && hasAuthRole() && isAdmin()
        && employeeId != myEmployeeId();

      // موظف عادي: توكن/دردشة، أو تعديل name/image على مستنده فقط (لا role/departments/email).
      allow update: if isSignedIn() && hasAuthRole() && isManager()
        || employeeAuthBootstrapUpdate()
        || (isSignedIn() && hasAuthRole() && isEmployeeRole()
          && employeeId == myEmployeeId()
          && employeeDocOwnedByCaller()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'fcmToken',
              'fcmTokens',
              'activeChatId',
              'activeChatUpdatedAt',
              'name',
              'image',
              'language',
            ]));
    }

    // ربط حساب Firebase Auth بمستند العميل عند أول تسجيل دخول — يجب أن يطابق البريد JWT مستند clients.email
    // (فرع authUid فارغ وحده غير كافٍ إذا كان الحقل موجودًا بقيمة قديمة أو اختلاف diff في القواعد).
    function clientAuthUidLinkUpdate() {
      return isSignedIn()
        && request.auth.token.email != null
        && resource.data.email == request.auth.token.email
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authUid', 'authStatus']);
    }

    match /clients/{clientId} {
      allow read: if canReadClientsDoc();

      allow create: if isSignedIn() && hasAuthRole() && isManager();

      allow delete: if isSignedIn() && hasAuthRole() && isAdmin();

      allow update: if isSignedIn() && hasAuthRole() && isManager()
        || clientAuthUidLinkUpdate()
        || (isSignedIn() && hasAuthRole() && isClientRole()
          && clientId == myClientId()
          && resource.data.authUid == request.auth.uid);
    }

    match /contents/{contentId} {
      allow read: if isSignedIn() && hasAuthRole() && canReadContentsDoc();

      allow create: if isSignedIn() && hasAuthRole()
        && (isManager()
          || (isEmployeeRole() && myDepartmentsList().hasAny(['publishing'])));

      allow delete: if isSignedIn() && hasAuthRole() && isManager();

      allow update: if isSignedIn() && hasAuthRole() && (
        isManager()
        || (isClientRole()
          && resource.data.clientId == myClientId()
          && request.resource.data.clientId == resource.data.clientId)
        || promotionEmployeeContentUpdateAllowed()
        || publishingEmployeeContentUpdateAllowed()
      );
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn() && hasAuthRole() && canReadTaskDoc();

      allow create: if isSignedIn() && hasAuthRole() && isManager();

      allow delete: if isSignedIn() && hasAuthRole() && isManager();

      allow update: if isSignedIn() && hasAuthRole() && isManager()
        || (isSignedIn() && hasAuthRole() && isEmployeeRole()
          && canReadTaskDoc()
          && employeeTaskUpdateAllowed());
    }

    match /notifications/{docId} {
      allow read: if isSignedIn() && hasAuthRole()
        && (isManager()
          || resource.data.recipientId == 'all'
          || resource.data.recipientId == myEmployeeId()
          || resource.data.recipientId == myClientId());

      allow create: if isSignedIn() && hasAuthRole();

      allow update, delete: if isSignedIn() && hasAuthRole()
        && (isManager()
          || resource.data.recipientId == myEmployeeId()
          || resource.data.recipientId == myClientId());
    }

    match /chats/{chatId} {
      // قراءة مستند غير موجود: لا يوجد resource.data.participants — يجب السماح لمجموعة القسم
      // حتى يعمل groupRef.get() قبل الإنشاء (نفس فكرة المحادثة الخاصة + set merge).
      allow read: if isSignedIn() && hasAuthRole()
        && (
          isManager()
          || (
            isEmployeeRole()
            && (
              (!exists(/databases/$(database)/documents/chats/$(chatId))
                && isDepartmentGroupChatId(chatId))
              || actorParticipantId() in resource.data.participants
              || isMyDepartmentGroupChat(chatId)
            )
          )
          || (
            isClientRole()
            && actorParticipantId() in resource.data.participants
          )
        );

      allow create: if isSignedIn() && hasAuthRole()
        && (
          isManager()
          || (
            isEmployeeRole()
            && (
              (
                request.resource.data.isGroup == true
                && isMyDepartmentGroupChat(chatId)
                && actorParticipantId() in request.resource.data.participants
              )
              || (
                request.resource.data.isGroup != true
                && request.resource.data.participants.size() == 2
                && actorParticipantId() in request.resource.data.participants
                && employeeOtherAllowedInPrivateChat(request.resource.data.participants)
                && chatId == expectedPrivateChatId(
                  (request.resource.data.participants[0] == myEmployeeId()
                    ? request.resource.data.participants[1]
                    : request.resource.data.participants[0])
                )
              )
            )
          )
          || (
            isClientRole()
            && actorParticipantId() in request.resource.data.participants
          )
        );

      // تحديث المحادثة: المدير كامل؛ الموظف داخل participants يحدّث lastMessage/lastUpdated فقط؛
      // أو ينضم لمجموعة قسمه إن لم يكن في participants بعد (لا يُربط بشرط "داخل participants" لأنه تعارض منطقي).
      allow update: if isSignedIn() && hasAuthRole()
        && (
          isManager()
          || (
            isEmployeeRole()
            && actorParticipantId() in resource.data.participants
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastUpdated'])
          )
          || (
            isEmployeeRole()
            && resource.data.isGroup == true
            && isMyDepartmentGroupChat(chatId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'lastUpdated'])
            && request.resource.data.participants.hasAll(resource.data.participants)
            && request.resource.data.participants.hasAny([myEmployeeId()])
            && request.resource.data.participants.size() == resource.data.participants.size() + 1
            && !resource.data.participants.hasAny([myEmployeeId()])
          )
          || (
            isClientRole()
            && actorParticipantId() in resource.data.participants
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastUpdated', 'participants', 'isGroup', 'title'])
          )
        );

      allow delete: if isSignedIn() && hasAuthRole() && isManager();

      match /messages/{messageId} {
        allow read: if isSignedIn() && hasAuthRole()
          && (
            isManager()
            || (
              isEmployeeRole()
              && (
                employeeCanReadGroupChatMessages(chatId)
                || (
                  get(/databases/$(database)/documents/chats/$(chatId)).data.isGroup != true
                  && actorParticipantId() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                )
              )
            )
            || (
              isClientRole()
              && actorParticipantId() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
            )
          );

        allow create: if isSignedIn() && hasAuthRole()
          && request.resource.data.senderId == actorParticipantId()
          && (
            isManager()
            || (
              isEmployeeRole()
              && (
                (
                  employeeCanReadGroupChatMessages(chatId)
                )
                || (
                  get(/databases/$(database)/documents/chats/$(chatId)).data.isGroup != true
                  && actorParticipantId() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                  && employeeOtherAllowedInPrivateChat(get(/databases/$(database)/documents/chats/$(chatId)).data.participants)
                )
              )
            )
            || (
              isClientRole()
              && actorParticipantId() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
            )
          );

        allow update: if isSignedIn() && hasAuthRole()
          && (
            messageMarkReadUpdate(chatId)
            || messageSoftDeleteByAdmin(chatId)
            || messageTextEditBySender(chatId)
            || messageTextEditByAdmin(chatId)
            || messagePinUpdate(chatId)
          );

        allow delete: if false;

        match /edits/{editId} {
          allow read: if isSignedIn() && hasAuthRole()
            && (
              isManager()
              || (
                isEmployeeRole()
                && (
                  employeeCanReadGroupChatMessages(chatId)
                  || (
                    get(/databases/$(database)/documents/chats/$(chatId)).data.isGroup != true
                    && actorParticipantId() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                  )
                )
              )
              || (
                isClientRole()
                && actorParticipantId() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
              )
            );

          allow create: if isSignedIn() && hasAuthRole()
            && messageParticipantInChat(chatId)
            && exists(/databases/$(database)/documents/chats/$(chatId)/messages/$(messageId))
            && request.resource.data.keys().hasOnly(['previousText', 'editedAt', 'editedBy', 'editedByName'])
            && request.resource.data.editedBy == actorParticipantId()
            && (
              isAdmin()
              || messageDocAt(chatId, messageId).senderId == actorParticipantId()
            )
            && messageDocIsTextEditable(messageDocAt(chatId, messageId))
            && messageDocNotSoftDeleted(messageDocAt(chatId, messageId));

          allow update, delete: if false;
        }
      }

      // Ephemeral DM typing pulses (employeeId as doc id). Not used for groups.
      match /typing/{userId} {
        allow read: if privateTypingReaderAllowed(chatId);

        allow create: if privateTypingActorMayWrite(chatId, userId)
          && privateTypingCreateDataOk();

        allow update: if privateTypingActorMayWrite(chatId, userId)
          && privateTypingUpdateDataOk();

        allow delete: if privateTypingActorMayWrite(chatId, userId);
      }
    }

    match /push_diagnostics/{docId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && hasAuthRole() && isManager();
      allow update, delete: if false;
    }

    match /app_error_logs/{docId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isSignedIn() && hasAuthRole() && isAdmin();
    }

    // إصدارات التطبيق: قراءة عامة لبوابة التحديث الإجباري على الموبايل (قبل تسجيل الدخول).
    // الكتابة من تطبيق الإدارة (admin فقط) عبر صفحة إعدادات التطبيق.
    match /appVersionGate/{docId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isAdmin() && docId == 'mobile'
        && appVersionGateValidMinBuild(request.resource.data.androidMinBuild)
        && appVersionGateValidMinBuild(request.resource.data.iosMinBuild)
        && (!('androidStoreUrl' in request.resource.data)
          || request.resource.data.androidStoreUrl is string)
        && (!('iosStoreUrl' in request.resource.data)
          || request.resource.data.iosStoreUrl is string);
      allow delete: if false;
    }

    // إعدادات Meta المشتركة: `app_settings/meta` (accessToken + graphVersion من التطبيق).
    // `app_settings/attendance` — موقع مقر الشركة لتسجيل الحضور.
    match /app_settings/{docId} {
      allow read: if isSignedIn() && hasAuthRole() && docId == 'meta'
        && metaPublishCanReadAppSettingsOrMetaPosts();

      allow read: if isSignedIn() && hasAuthRole() && !isClientRole()
        && docId == 'attendance';

      allow create, update: if isSignedIn() && hasAuthRole() && docId == 'meta'
        && metaPublishCanWriteAppSettingsMeta()
        && request.resource.data.keys().hasAll(['accessToken', 'graphVersion'])
        && request.resource.data.accessToken is string
        && request.resource.data.graphVersion is string;

      allow create, update: if isSignedIn() && isAdmin() && docId == 'attendance'
        && validAttendanceSettings(request.resource.data);

      allow delete: if false;
    }

    // مسودات وسجل النشر إلى Meta (MetaPostModel) — إدارة فقط.
    match /meta_posts/{postId} {
      allow read: if isSignedIn() && hasAuthRole()
        && metaPublishCanReadAppSettingsOrMetaPosts();

      allow create: if isSignedIn() && hasAuthRole()
        && metaPublishCanReadAppSettingsOrMetaPosts();

      allow update: if isSignedIn() && hasAuthRole()
        && metaPublishCanReadAppSettingsOrMetaPosts();

      allow delete: if isSignedIn() && hasAuthRole() && metaPublishCanWriteAppSettingsMeta();
    }

    // Presence heartbeat for lightweight online/last-seen (employees list + chat headers).
    // Regular employees must read others' docs too (including admin/supervisor DMs).
    // Clients do not participate in employee presence.
    match /employee_presence/{employeeId} {
      allow read: if isSignedIn() && hasAuthRole() && !isClientRole();

      allow create, update: if isSignedIn() && hasAuthRole()
        && authRoleData().role != 'client'
        && employeeId == myEmployeeId()
        && request.resource.data.keys().hasOnly(['employeeId', 'lastSeenAt'])
        && request.resource.data.employeeId == employeeId;

      allow delete: if false;
    }

    // GPS attendance check-in/out records.
    match /attendance_records/{recordId} {
      allow read: if isSignedIn() && hasAuthRole()
        && (isAdmin() || (isEmployeeRole() && resource.data.employeeId == myEmployeeId()));

      allow create: if isSignedIn() && hasAuthRole()
        && isEmployeeRole()
        && request.resource.data.employeeId == myEmployeeId()
        && validAttendanceRecord(request.resource.data);

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
