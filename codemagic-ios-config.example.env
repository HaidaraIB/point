# أضف هذه المفاتيح في Codemagic → Environment variables → مجموعة: ios_config
# لا تضع قيماً سِرّية حقيقية في Git — انسخ القيم من لوحة Codemagic فقط عند الحاجة للمرجع المحلي.

# محتوى GoogleService-Info.plist كاملاً (XML) من Firebase Console → مشروع الإنتاج point-agency-production
# (تطبيق iOS com.point.agency). لا تستخدم plist مشروع الاختبار هنا.
GOOGLE_SERVICE_INFO_PLIST=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BASE_URL=
